{
  "name": "mail-manager",
  "productName": "Mail Manager",
  "version": "0.1.0",
  "description": "300 アカウント規模のメールアカウントを 1 つの GUI から管理するデスクトップアプリ",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "format": "eslint --fix src",
    "format:prettier": "prettier --write \"src/**/*.{ts,tsx,scss,css}\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "gen:csv": "node --import tsx scripts/gen-accounts-csv.ts",
    "dev:servers": "node --import tsx scripts/dev-servers.ts",
    "publish": "electron-forge publish"
  },
  "license": "MIT",
  "dependencies": {
    "@tanstack/react-router": "1.170.32",
    "csv-parse": "^7.0.2",
    "electron-squirrel-startup": "^1.0.1",
    "imapflow": "^1.7.8",
    "kysely": "^0.29.5",
    "mailparser": "^3.9.20",
    "nodemailer": "^7.0.13",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "update-electron-app": "^3.3.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/publisher-github": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tanstack/react-virtual": "^3.14.10",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitejs/plugin-react": "^5.0.0",
    "dompurify": "^3.4.14",
    "electron": "44.2.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.12.0",
    "i18next": "^26.4.2",
    "prettier": "^3.9.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.0",
    "sass-embedded": "^1.104.0",
    "selfsigned": "^5.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.0",
    "vitest": "^5.0.0",
    "zustand": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ANFINII/mail-manager.git"
  },
  "author": "ANFINII"
}
